{
  "name": "edgeinfer",
  "version": "1.0.0",
  "description": "On-device AI inference engine using ONNX Runtime WebAssembly and WebGPU",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itsoumya-d/edgeinfer"
  },
  "homepage": "https://itsoumya-d.github.io/edgeinfer/",
  "bugs": {
    "url": "https://github.com/itsoumya-d/edgeinfer/issues"
  },
  "keywords": [
    "onnx",
    "webgpu",
    "wasm",
    "inference",
    "ai"
  ],
  "author": "Soumya Debnath",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.17.0"
  }
}
